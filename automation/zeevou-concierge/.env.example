# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Zeevou login -----------------------------------------------------------
ZEEVOU_EMAIL=you@example.com
ZEEVOU_PASSWORD=
# Your Zeevou tenant URL, no trailing slash.
ZEEVOU_BASE_URL=https://app.zeevou.com
# Path to the Unified Inbox, relative to ZEEVOU_BASE_URL.
ZEEVOU_INBOX_PATH=/unified-inbox

# --- Claude -----------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium

# --- Telegram ---------------------------------------------------------------
# From @BotFather.
TELEGRAM_BOT_TOKEN=
# Your own chat id. Run `python -m zeevou_concierge whoami` after messaging the
# bot once, and it will print the chat id it sees.
TELEGRAM_CHAT_ID=

# --- Behaviour --------------------------------------------------------------
# Inbox is checked at a random interval between these two bounds (seconds).
POLL_MIN_SECONDS=300
POLL_MAX_SECONDS=600
# Run the browser without a visible window. Set to false while fixing selectors.
HEADLESS=true
# true = draft and ask for approval, but never actually send to Zeevou.
DRY_RUN=false
# Most guest messages to draft replies for in a single cycle.
MAX_DRAFTS_PER_CYCLE=10
# Alert if no inbox check has succeeded for this many minutes.
WATCHDOG_MINUTES=45
# Where state, cookies and failure screenshots live.
DATA_DIR=./data
# Per-property facts Claude is allowed to quote.
PROPERTIES_FILE=./config/properties.json
