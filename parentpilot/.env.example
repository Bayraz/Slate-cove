# Copy to .env and fill in. NEVER commit .env.
#
# Anything prefixed EXPO_PUBLIC_ is compiled into the app bundle and visible to
# anyone who installs it. Only put values here that are safe to be public
# (the Supabase URL and the anon key, which is protected by row-level security).
#
# Secrets (AI provider keys, Supabase service-role key, push credentials) must
# NEVER be given an EXPO_PUBLIC_ prefix. They live server-side, e.g. as
# Supabase Edge Function secrets, and the app only talks to that function.

# "mock" runs entirely on local demo data, with no backend (default).
# "supabase" uses the real backend once the Supabase repositories exist.
EXPO_PUBLIC_DATA_SOURCE=mock

# Supabase project (Project settings > API). Leave blank to run in demo mode.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Endpoint of the server-side AI function that will call the model.
# Leave blank: the Ask screen then uses the clearly-labelled preview assistant.
EXPO_PUBLIC_AI_ENDPOINT=

# Emergency number shown by the safety guidance (999 in the UK, 911 in the US).
EXPO_PUBLIC_EMERGENCY_NUMBER=999
