# Copy to .env and fill in. NEVER commit .env.
#
# Anything prefixed EXPO_PUBLIC_ is compiled into the app bundle and visible to
# anyone who installs it. Only put values here that are safe to be public:
# the Supabase project URL and the ANON (public) key. Family data is protected
# by row-level security in Postgres, not by hiding this key.
#
# NEVER put the Supabase service-role key, an AI provider key, or any other
# secret in this file or behind an EXPO_PUBLIC_ name. Those live server-side only
# (e.g. Supabase Edge Function secrets).

# --- Supabase (Project settings > API) ------------------------------------
# Both must be set to use the real backend. If either is blank or invalid the
# app falls back to DEMO MODE (sample data, nothing saved) and says so on Today.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Set to "mock" to force demo mode even when Supabase is configured (development only).
EXPO_PUBLIC_DATA_SOURCE=

# Demo mode only: "empty" starts with no family so you can try onboarding without a backend.
EXPO_PUBLIC_DEMO_SCENARIO=

# --- Later phases ----------------------------------------------------------
# Endpoint of the server-side AI function (not built yet). Blank = preview assistant.
EXPO_PUBLIC_AI_ENDPOINT=

# Emergency number shown by the safety guidance (999 in the UK, 911 in the US).
EXPO_PUBLIC_EMERGENCY_NUMBER=999
